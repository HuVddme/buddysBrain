    {
      "id": "limits-01",
      "document": "limits",
      "question": "In CALC101, what does a limit describe?",
      "expected_answer": "The value a function approaches as its input approaches a number.",
      "supporting_passages": [
        "limits:1"
      ],
      "expected_patterns": [
        [
          "approach"
        ]
      ]
    },
    {
      "id": "limits-02",
      "document": "limits",
      "question": "According to CALC101, can a limit exist where the function is undefined?",
      "expected_answer": "Yes. It concerns nearby behavior.",
      "supporting_passages": [
        "limits:1"
      ],
      "expected_patterns": [
        [
          "yes",
          "can exist"
        ],
        [
          "near",
          "approach"
        ]
      ]
    },
    {
      "id": "limits-03",
      "document": "limits",
      "question": "What is the limit of (x² - 4)/(x - 2) as x approaches 2 in CALC101?",
      "expected_answer": "4",
      "supporting_passages": [
        "limits:2"
      ],
      "expected_patterns": [
        [
          "\\b4\\b",
          "four"
        ]
      ]
    },
    {
      "id": "limits-04",
      "document": "limits",
      "question": "Which expression equals (x² - 4)/(x - 2) when x is not 2 in CALC101?",
      "expected_answer": "x + 2",
      "supporting_passages": [
        "limits:2"
      ],
      "expected_patterns": [
        [
          "x\\s*\\+\\s*2"
        ]
      ]
    },
    {
      "id": "limits-05",
      "document": "limits",
      "question": "Is the original CALC101 rational expression defined at x=2?",
